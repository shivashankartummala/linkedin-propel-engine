# ==========================================
# LinkedIn Propel Engine Configuration
# ==========================================

# 1. LINKEDIN AUTHENTICATION
# Your LinkedIn session cookie (bypasses 2FA & CAPTCHAs).
#
# ⏱️ LIFETIME & PERSISTENCE:
# This cookie is valid for MULTIPLE MONTHS (typically 60 to 90+ days, and up to a full year).
# You only need to configure this ONCE. It will remain active until you explicitly log out
# or change your LinkedIn password.
#
# How to get it in 15 seconds:
# 1. Open Google Chrome and log into https://www.linkedin.com
# 2. Press F12 (or Right Click -> Inspect) -> Click "Application" (or "Storage") tab.
# 3. In the left sidebar: Expand "Cookies" -> Click "https://www.linkedin.com".
# 4. Find the cookie named "li_at" and copy its value here.
LINKEDIN_LI_AT="AQEDA..."

# Your own LinkedIn profile URL (to prevent the engine from commenting on your own posts)
MY_PROFILE_URL="https://www.linkedin.com/in/your-profile-slug/"

# 2. LLM CONFIGURATION (METAMUSE AGENT-NATIVE BY DEFAULT)
# In Metamuse, leave LLM_API_KEY blank! Metamuse uses its own free cloud model credits.
# If running standalone outside Metamuse, you can optionally provide an API key.
LLM_PROVIDER="openai"
LLM_API_KEY=""
LLM_BASE_URL=""
LLM_MODEL="gpt-4o-mini"

# 3. SAFETY & BEHAVIOR
HEADLESS=true
DRY_RUN=false
MAX_COMMENTS_PER_RUN=4
MAX_DAILY_COMMENTS=12
MIN_DELAY_BETWEEN_MEMBERS_SECONDS=20
MAX_DELAY_BETWEEN_MEMBERS_SECONDS=50
